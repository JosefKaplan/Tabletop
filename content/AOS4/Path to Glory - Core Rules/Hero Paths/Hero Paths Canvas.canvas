		{"id":"d-a1","type":"text","text":"**Focused Meditation**\nGain D3 ritual points during the deployment phase.","x":2850,"y":130,"width":400,"height":130,"color":"3"},
		{"id":"d-b1","type":"text","text":"**Divine Blessing**\nThis PRIEST has WARD (6+).","x":3350,"y":130,"width":400,"height":130,"color":"3"},
		{"id":"d-c2","type":"text","text":"**Elite**\n15–29 Renown — pick 1 of 2","x":3150,"y":320,"width":300,"height":70,"color":"3"},
		{"id":"d-a2","type":"text","text":"**Righteous Conviction** (chanting 4)\nFriendly unit within 12\" adds 1 to wound rolls this turn.","x":2850,"y":450,"width":400,"height":130,"color":"3"},
		{"id":"d-b2","type":"text","text":"**Resurrection** (chanting 7, once/battle)\nReturn a slain friendly INFANTRY HERO within 3\".","x":3350,"y":450,"width":400,"height":130,"color":"3"},
		{"id":"d-c3","type":"text","text":"**Mighty**\n30–44 Renown — pick 1 of 2","x":3150,"y":640,"width":300,"height":70,"color":"3"},
		{"id":"d-a3","type":"text","text":"**Master of Ceremonies**\nRoll 2 dice for chanting rolls, pick 1.","x":2850,"y":770,"width":400,"height":130,"color":"3"},
		{"id":"d-b3","type":"text","text":"**Hallowed Champion**\nFriendly units wholly within 12\" have WARD (6+).","x":3350,"y":770,"width":400,"height":130,"color":"3"},
		{"id":"d-c4","type":"text","text":"**Legendary**\n45+ Renown — pick 1 of 2, final tier","x":3150,"y":960,"width":300,"height":70,"color":"3"},
		{"id":"d-a4","type":"text","text":"**Ritual of Death** (chanting 6)\nEach enemy unit suffers 1 mortal damage (D3 if the roll was 9+).","x":2850,"y":1090,"width":400,"height":150,"color":"3"},
		{"id":"d-b4","type":"text","text":"**Ritual of Life** (chanting 8)\nHeal (1) each friendly unit (D3 if the roll was 9+).","x":3350,"y":1090,"width":400,"height":150,"color":"3"}
