		{"id":"idx","type":"file","file":"tabletop/AOS4/Path to Glory - Core Rules/Hero Paths/Hero Paths.md","x":1050,"y":-620,"width":900,"height":260},
		{"id":"w-header","type":"file","file":"tabletop/AOS4/Path to Glory - Core Rules/Hero Paths/Path of the Warrior.md","x":-450,"y":-260,"width":900,"height":180,"color":"1"},
		{"id":"w-c1","type":"text","text":"**Aspiring**\n5–14 Renown — pick 1 of 2","x":-150,"y":0,"width":300,"height":70,"color":"1"},
		{"id":"w-a1","type":"text","text":"**Berserker**\nRe-roll charge rolls for this HERO.","x":-450,"y":130,"width":400,"height":130,"color":"1"},
		{"id":"w-b1","type":"text","text":"**Well of Strength**\nHeal (D6) this HERO once per battle.","x":50,"y":130,"width":400,"height":130,"color":"1"},
		{"id":"w-c2","type":"text","text":"**Elite**\n15–29 Renown — pick 1 of 2","x":-150,"y":320,"width":300,"height":70,"color":"1"},
		{"id":"w-a2","type":"text","text":"**Martial Expertise**\nAdd 1 to hit rolls for this HERO's combat attacks.","x":-450,"y":450,"width":400,"height":130,"color":"1"},
		{"id":"w-b2","type":"text","text":"**Powerful Presence**\nAdd D3 to control score when contesting an uncontrolled objective.","x":50,"y":450,"width":400,"height":130,"color":"1"},
		{"id":"w-c3","type":"text","text":"**Mighty**\n30–44 Renown — pick 1 of 2","x":-150,"y":640,"width":300,"height":70,"color":"1"},
		{"id":"w-a3","type":"text","text":"**Master-Crafted Armour**\nAdd 1 to save rolls for this HERO.","x":-450,"y":770,"width":400,"height":130,"color":"1"},
		{"id":"w-b3","type":"text","text":"**Master-Crafted Weapons**\nAdd 1 to Rend of this HERO's melee weapons.","x":50,"y":770,"width":400,"height":130,"color":"1"},
		{"id":"w-c4","type":"text","text":"**Legendary**\n45+ Renown — pick 1 of 2, final tier","x":-150,"y":960,"width":300,"height":70,"color":"1"},
		{"id":"w-a4","type":"text","text":"**Warrior Without Equal**\nThis HERO has WARD (4+).","x":-450,"y":1090,"width":400,"height":130,"color":"1"},
		{"id":"w-b4","type":"text","text":"**Unparalleled Duellist**\nThis HERO has STRIKE-FIRST.","x":50,"y":1090,"width":400,"height":130,"color":"1"},
		{"id":"l-header","type":"file","file":"tabletop/AOS4/Path to Glory - Core Rules/Hero Paths/Path of the Leader.md","x":650,"y":-260,"width":900,"height":180,"color":"6"},
		{"id":"l-c1","type":"text","text":"**Aspiring**\n5–14 Renown — pick 1 of 2","x":950,"y":0,"width":300,"height":70,"color":"6"},
		{"id":"l-a1","type":"text","text":"**Tactical Acumen**\nFriendly unit within 12\" can use the Redeploy command for free.","x":650,"y":130,"width":400,"height":130,"color":"6"},
		{"id":"l-b1","type":"text","text":"**Conserved Strength**\nHeal (1) this HERO at the end of each turn.","x":1150,"y":130,"width":400,"height":130,"color":"6"},
		{"id":"l-c2","type":"text","text":"**Elite**\n15–29 Renown — pick 1 of 2","x":950,"y":320,"width":300,"height":70,"color":"6"},
		{"id":"l-a2","type":"text","text":"**Masterful Commander**\nStart of battle round, roll a dice — on 4+ gain 1 command point.","x":650,"y":450,"width":400,"height":130,"color":"6"},
		{"id":"l-b2","type":"text","text":"**Rousing Orator**\nAdd 1 to rally rolls for friendly units wholly within 12\".","x":1150,"y":450,"width":400,"height":130,"color":"6"},
		{"id":"l-c3","type":"text","text":"**Mighty**\n30–44 Renown — pick 1 of 2","x":950,"y":640,"width":300,"height":70,"color":"6"},
		{"id":"l-a3","type":"text","text":"**Defender of the Realm**\nSTRIKE-FIRST while wholly within friendly territory.","x":650,"y":770,"width":400,"height":130,"color":"6"},
		{"id":"l-b3","type":"text","text":"**Hardy Constitution**\nAdd 2 to this HERO's Health characteristic.","x":1150,"y":770,"width":400,"height":130,"color":"6"},
		{"id":"l-c4","type":"text","text":"**Legendary**\n45+ Renown — pick 1 of 2, final tier","x":950,"y":960,"width":300,"height":70,"color":"6"},
		{"id":"l-a4","type":"text","text":"**Destined for Greatness**\nThis HERO has WARD (4+).","x":650,"y":1090,"width":400,"height":130,"color":"6"},
		{"id":"l-b4","type":"text","text":"**Inspiring Leader**\nAdd 3 to control score of other friendly units contesting the same objective.","x":1150,"y":1090,"width":400,"height":130,"color":"6"},
		{"id":"m-header","type":"file","file":"tabletop/AOS4/Path to Glory - Core Rules/Hero Paths/Path of the Mage.md","x":1750,"y":-260,"width":900,"height":180,"color":"5"},
		{"id":"m-c1","type":"text","text":"**Aspiring**\n5–14 Renown — pick 1 of 2","x":2050,"y":0,"width":300,"height":70,"color":"5"},
		{"id":"m-a1","type":"text","text":"**Dedicated Practitioner**\nAdd 1 to casting rolls for this WIZARD.","x":1750,"y":130,"width":400,"height":130,"color":"5"},
		{"id":"m-b1","type":"text","text":"**Eldritch Ward**\nCasting roll of 10+ grants WARD (5+) until your next turn.","x":2250,"y":130,"width":400,"height":130,"color":"5"},
		{"id":"m-c2","type":"text","text":"**Elite**\n15–29 Renown — pick 1 of 2","x":2050,"y":320,"width":300,"height":70,"color":"5"},
		{"id":"m-a2","type":"text","text":"**Mystic Shield** (casting 6)\nFriendly unit within 12\" gains WARD (6+) until your next turn.","x":1750,"y":450,"width":400,"height":130,"color":"5"},
		{"id":"m-b2","type":"text","text":"**Arcane Conduit** (casting 3)\nAdd 1 to friendly WIZARD casting rolls until end of phase.","x":2250,"y":450,"width":400,"height":130,"color":"5"},
		{"id":"m-c3","type":"text","text":"**Mighty**\n30–44 Renown — pick 1 of 2","x":2050,"y":640,"width":300,"height":70,"color":"5"},
		{"id":"m-a3","type":"text","text":"**Magical Might**\nHeal (D3) this WIZARD after successfully casting a spell.","x":1750,"y":770,"width":400,"height":130,"color":"5"},
		{"id":"m-b3","type":"text","text":"**Arcane Familiar**\nOnce per phase, re-roll 1 casting die for this WIZARD.","x":2250,"y":770,"width":400,"height":130,"color":"5"},
		{"id":"m-c4","type":"text","text":"**Legendary**\n45+ Renown — pick 1 of 2, final tier","x":2050,"y":960,"width":300,"height":70,"color":"5"},
		{"id":"m-a4","type":"text","text":"**Eldritch Cataclysm** (casting 8)\nRoll a dice per model in an enemy unit within 15\" — each 4+ deals 1 mortal damage.","x":1750,"y":1090,"width":400,"height":150,"color":"5"},
		{"id":"m-b4","type":"text","text":"**Sunder the Earth** (casting 8)\nDraw a line within 18\" — each unit crossed suffers D3 mortal damage.","x":2250,"y":1090,"width":400,"height":150,"color":"5"},
		{"id":"d-header","type":"file","file":"tabletop/AOS4/Path to Glory - Core Rules/Hero Paths/Path of the Devout.md","x":2850,"y":-260,"width":900,"height":180,"color":"3"},
